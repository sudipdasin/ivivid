#!/usr/bin/env python3
"""Read-only release discovery; never downloads or executes an installer."""
import argparse
import json
import re
import sys
import urllib.request

BASE = 'https://github.com/sudipdasin/ivivid/releases/'
API = 'https://api.github.com/repos/sudipdasin/ivivid/releases?per_page=100'
VERSION = re.compile(r'v?(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-beta\.(0|[1-9]\d*))?\Z', re.ASCII)


def version(value):
    m = VERSION.fullmatch(value) if isinstance(value, str) else None
    if not m:
        raise ValueError('Unsupported version')
    a, b, c, beta = m.groups()
    return int(a), int(b), int(c), int(beta is None), int(beta or 0)


def select_release(releases, current, channel, package):
    installed = version(current)
    if channel not in ('stable', 'beta') or package not in ('deb', 'zip'):
        raise ValueError('Unsupported channel or package')
    if not isinstance(releases, list):
        raise ValueError('Invalid release response')
    candidates = []
    for item in releases:
        if not isinstance(item, dict) or item.get('draft') is not False:
            continue
        tag = item.get('tag_name')
        try:
            key = version(tag)
        except ValueError:
            continue
        if not tag.startswith('v') or key <= installed:
            continue
        if item.get('prerelease') is not (key[3] == 0):
            continue
        if channel == 'stable' and key[3] == 0:
            continue
        number = tag[1:]
        name = f'ivivid_{number}_amd64.deb' if package == 'deb' else f'ivivid-{number}-linux-amd64.zip'
        assets = item.get('assets')
        if not isinstance(assets, list):
            continue
        def valid_asset(expected):
            url = BASE + 'download/' + tag + '/' + expected
            matches = [a for a in assets if isinstance(a, dict) and a.get('name') == expected]
            return len(matches) == 1 and matches[0].get('browser_download_url') == url and matches[0].get('state') == 'uploaded'
        if not all(valid_asset(required) for required in (name, 'SHA256SUMS', 'manifest.json', 'manifest.sig')):
            continue
        candidates.append((key, number))
    return max(candidates)[1] if candidates else None


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--current', required=True)
    parser.add_argument('--channel', choices=('stable', 'beta'), required=True)
    parser.add_argument('--format', choices=('deb', 'zip'), required=True)
    args = parser.parse_args()
    try:
        request = urllib.request.Request(API, headers={'Accept': 'application/vnd.github+json', 'User-Agent': 'iVivid-update-check'})
        with urllib.request.urlopen(request, timeout=8) as response:
            if response.geturl() != API:
                raise ValueError('Unexpected release API redirect')
            raw = response.read(4 * 1024 * 1024 + 1)
        if len(raw) > 4 * 1024 * 1024:
            raise ValueError('Release response too large')
        latest = select_release(json.loads(raw), args.current, args.channel, args.format)
        print(latest or 'CURRENT')
        return 0
    except (OSError, ValueError, OverflowError) as error:
        print('Update check unavailable: ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
